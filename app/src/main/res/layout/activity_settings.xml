<?xml version="1.0" encoding="utf-8"?>
<!-- Экран настроек: шапка со стрелкой "назад" и список из четырёх пунктов -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/padding_large">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/yp_black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/content_top_padding"
            android:text="@string/settings"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/header_text_size"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Список настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/content_top_padding">

        <!-- Тёмная тема + переключатель -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/dark_theme"
                android:textColor="@color/yp_black"
                android:textSize="@dimen/settings_text_size" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/dark_theme_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Поделиться приложением -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/share_app"
                android:textColor="@color/yp_black"
                android:textSize="@dimen/settings_text_size" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_share"
                app:tint="@color/yp_gray" />
        </LinearLayout>

        <!-- Написать в поддержку -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/write_to_support"
                android:textColor="@color/yp_black"
                android:textSize="@dimen/settings_text_size" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_support"
                app:tint="@color/yp_gray" />
        </LinearLayout>

        <!-- Пользовательское соглашение -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/settings_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/padding_large"
            android:paddingEnd="@dimen/padding_medium">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/user_agreement"
                android:textColor="@color/yp_black"
                android:textSize="@dimen/settings_text_size" />

            <ImageView
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/yp_gray" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
