<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".SettingsActivity">

    <!-- Шапка: "Назад" + заголовок -->
    <LinearLayout style="@style/ScreenHeaderStyle">

        <ImageButton
            android:id="@+id/back_button"
            style="@style/BackButtonStyle" />

        <TextView
            style="@style/HeaderTitleStyle"
            android:text="@string/settings" />
    </LinearLayout>

    <!-- Тёмная тема: пока только переключатель, логика будет в следующих спринтах -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/themeSwitch"
        style="@style/SettingsSwitchStyle"
        android:layout_marginTop="24dp"
        android:text="@string/dark_theme" />

    <TextView
        android:id="@+id/shareButton"
        style="@style/SettingsItemStyle"
        android:text="@string/share_app"
        android:drawableEnd="@drawable/ic_share" />

    <TextView
        android:id="@+id/supportButton"
        style="@style/SettingsItemStyle"
        android:text="@string/write_to_support"
        android:drawableEnd="@drawable/ic_support" />

    <TextView
        android:id="@+id/agreementButton"
        style="@style/SettingsItemStyle"
        android:text="@string/user_agreement"
        android:drawableEnd="@drawable/ic_arrow_forward" />
</LinearLayout>
