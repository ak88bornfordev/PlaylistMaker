<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран: синий фон, заголовок и три кнопки,
     которые делят между собой всю оставшуюся высоту экрана -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/yp_blue"
    android:id="@+id/main"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Отступы заданы через margin у дочерних элементов, а не padding у корня:
         padding корня занимают отступы под системные панели (см. MainActivity) -->

    <!-- Заголовок -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:layout_marginHorizontal="@dimen/padding_large"
        android:gravity="center_vertical"
        android:text="@string/main_title"
        android:textColor="@color/yp_white"
        android:textSize="@dimen/header_text_size"
        android:textStyle="bold" />

    <!-- Кнопки: высота 0dp + layout_weight="1" = каждая берёт треть свободного места -->
    <Button
        android:id="@+id/search_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_large"
        android:layout_marginTop="@dimen/content_top_padding"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/search"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/main_button_text_size"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/main_button_corner_radius"
        app:icon="@drawable/ic_search"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/padding_small"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

    <Button
        android:id="@+id/media_library_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_large"
        android:layout_marginTop="@dimen/padding_large"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/media_library"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/main_button_text_size"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/main_button_corner_radius"
        app:icon="@drawable/ic_media_library"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/padding_small"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

    <Button
        android:id="@+id/settings_button"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/padding_large"
        android:layout_marginTop="@dimen/padding_large"
        android:layout_marginBottom="@dimen/padding_large"
        android:layout_weight="1"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/settings"
        android:textAllCaps="false"
        android:textColor="@color/yp_black"
        android:textSize="@dimen/main_button_text_size"
        app:backgroundTint="@color/yp_white"
        app:cornerRadius="@dimen/main_button_corner_radius"
        app:icon="@drawable/ic_settings"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/padding_small"
        app:iconSize="@dimen/icon_size"
        app:iconTint="@color/yp_black" />

</LinearLayout>
    <!-- Черновик -->