<?xml version="1.0" encoding="utf-8"?>
<!-- Главный экран. Тема Theme.PlaylistMaker.Main задаёт фон: синий днём, тёмный ночью -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="28dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:text="@string/main_title"
        android:textColor="@color/yp_white"
        android:textSize="22sp"
        android:fontFamily="@font/ys_display_medium"
        android:textFontWeight="500" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_button"
        style="@style/MainButtonStyle"
        android:layout_marginTop="24dp"
        android:text="@string/search"
        app:icon="@drawable/ic_search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/media_library_button"
        style="@style/MainButtonStyle"
        android:text="@string/media_library"
        app:icon="@drawable/ic_media_library" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settings_button"
        style="@style/MainButtonStyle"
        android:text="@string/settings"
        app:icon="@drawable/ic_settings" />
</LinearLayout>
